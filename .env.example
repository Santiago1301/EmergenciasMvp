# Copia este archivo a ".env" (ya esta en .gitignore) para desarrollo local.
# Lo usan los 4 microservicios via docker-compose (env_file: .env).
# En AWS estas mismas variables las inyecta Lambda desde Secrets Manager /
# Parameter Store -- nunca desde un archivo en el repo.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Nombre del bus de EventBridge (solo se usa de verdad en AWS; en local, si
# no hay credenciales de AWS configuradas, publish_event solo lo loguea).
EVENT_BUS_NAME=emergencias-bus

# URL del mock del organismo externo, ya apuntado por defecto en docker-compose
# al servicio mock-organismo. Cambiar solo si se prueba contra otro receptor.
ORGANISMO_WEBHOOK_URL=http://mock-organismo:8000/webhook
