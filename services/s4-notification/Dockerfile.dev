# SOLO para docker-compose en local. En este modo se sirve app:app (FastAPI)
# con el endpoint /internal/events que simula la invocacion de EventBridge --
# en produccion, EventBridge invoca lambda_handler directamente (ver Dockerfile).
FROM python:3.12-slim
WORKDIR /build
COPY libs/emergencias_common ./libs/emergencias_common
COPY services/s4-notification/requirements.txt ./services/s4-notification/requirements.txt
RUN pip install --no-cache-dir -r services/s4-notification/requirements.txt && \
    pip install --no-cache-dir ./libs/emergencias_common
COPY services/s4-notification/app ./services/s4-notification/app
WORKDIR /build/services/s4-notification
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
