# SOLO para docker-compose en local (ver nota en s1-intake/Dockerfile.dev).
FROM python:3.12-slim
WORKDIR /build
COPY libs/emergencias_common ./libs/emergencias_common
COPY services/s3-geospatial/requirements.txt ./services/s3-geospatial/requirements.txt
RUN pip install --no-cache-dir -r services/s3-geospatial/requirements.txt && \
    pip install --no-cache-dir ./libs/emergencias_common
COPY services/s3-geospatial/app ./services/s3-geospatial/app
WORKDIR /build/services/s3-geospatial
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
