# SOLO para docker-compose en local. El Dockerfile (sin .dev) es el que se
# usa para el deploy real a Lambda -- mismo codigo de app/, base distinta,
# porque la imagen de Lambda no esta pensada para correr un servidor HTTP
# arbitrario con reload en caliente.
FROM python:3.12-slim
WORKDIR /build
COPY libs/emergencias_common ./libs/emergencias_common
COPY services/s1-intake/requirements.txt ./services/s1-intake/requirements.txt
RUN pip install --no-cache-dir -r services/s1-intake/requirements.txt && \
    pip install --no-cache-dir ./libs/emergencias_common
COPY services/s1-intake/app ./services/s1-intake/app
WORKDIR /build/services/s1-intake
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
